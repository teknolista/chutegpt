# =============================================================================
# .gitignore — Universal, language- and platform-independent template
# Add stack-specific rules only when they are needed by the project.
# 1. Local environment files (may contain secrets)
.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.dist
!.env.*.example
!.env.*.sample
!.env.*.template
.envrc.local
# 2. Logs and process state files
*.pid
*.pid.lock
# 3. Temporary files and editor backups
*.tmp
*.temp
*.bak
*.old
*~
.#*
\#*#
*.orig
*.rej
# 4. Local tool caches and histories
.cache/
.tmp/
.temp/
# 5. Personal IDE files (keep shareable project settings trackable)
.idea/workspace.xml
.idea/tasks.xml
.idea/shelf/
.idea/httpRequests/
.idea/usage.statistics.xml
.vscode/.history/
*.sublime-workspace
# 6. Operating system metadata
.AppleDouble
.LSOverride
._*
.Spotlight-V100/
.Trashes/
.fseventsd/
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.directory
# OPTIONAL RULES — enable only when appropriate for the project.
# These patterns are not universal and may hide legitimate project files.
# /build/
# /dist/
# /out/
# /coverage/
# /tmp/
# /logs/
# /artifacts/
# /reports/
#
# Keep language- and framework-specific patterns in each project's .gitignore
# (e.g., node_modules/, __pycache__/, target/, .gradle/).
# Do not ignore *.lock, *.json, *.db, *.key, or *.pem indiscriminately:
# some of these files may legitimately need to be version-controlled.
# ==============================================================================
# AI development artifacts: skills, context, prompts, and agent-specific files
# Local append-only prompt log and its log-file rotated variants (see AGENTS.md)

# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# rustc will dump stack traces when hitting an internal compiler error to PWD
rustc-ice-*.txt

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Operating systems
.DS_Store
Thumbs.db

# Editors
.idea/
*.iml
*.swp
*.swo

# Ignore legacy code
legacy/

# Logs and local diagnostics
*.log

# Temporary files from document editors
docs/**/~$*
docs/**/*.tmp
docs/eBooks/

# Local environment files
**/.env
**/.env.*
!**/.env.example

# Generated daily Caixa results and local update state
/docs/Dia de Sorte-atual.xlsx
/docs/.dia-de-sorte-atualizacao.json
__pycache__/

# Local lock for the Caixa workbook updater
/docs/.dia-de-sorte-atualizacao.lock

# Visual Studio Code files
.vscode/
.history/
prettierignore.txt
*.code-workspace
# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# AI development artifacts: skills, context, prompts, instructions, and agent-specific files
.ai/
.ai-context/
.context/
.vibes/
.agents/
.skills/
.cursor/
.cursorrules
.windsurfrules
.opencode/
skills-lock.json

# Local append-only prompt log (mandatory) and its log-file rotated variants (see AGENTS.md)
/AGENTS.log
/AGENTS.log.*
